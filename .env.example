# Copy to .env and fill in real values. .env is git-ignored. NEVER commit real secrets.

# --- PostgreSQL (used by docker-compose and the backend) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# SQLAlchemy URL for psycopg 3, e.g. postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM provider (configurable; wired up in M8) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (wired up in M6) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Must match the chosen model. The pgvector column size is fixed by this number.
EMBEDDING_DIMENSIONS=

# --- App limits / CORS ---
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
